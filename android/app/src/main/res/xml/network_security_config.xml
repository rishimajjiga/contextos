<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, everywhere. No cleartext exceptions, no user-added CA trust. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
