<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android 12+ backup/transfer rules. Mirror backup_rules.xml: everything backs up EXCEPT
         the two credential-bearing shared-pref files (see backup_rules.xml for the rationale).
         Excluding a path implicitly includes everything else, so WebView cookies/localStorage
         (login session) still travel with a cloud backup or device transfer. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="contextos_bubble_secure.xml" />
        <exclude domain="sharedpref" path="contextos_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="contextos_bubble_secure.xml" />
        <exclude domain="sharedpref" path="contextos_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
