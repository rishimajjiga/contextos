# Copy to android/keystore.properties (gitignored) and fill in real values before a release build.
# Generate a keystore with:
#   keytool -genkey -v -keystore release.keystore.jks -alias contextos -keyalg RSA -keysize 2048 -validity 10000
storeFile=../release.keystore.jks
storePassword=CHANGE_ME
keyAlias=contextos
keyPassword=CHANGE_ME
